{
  "manifest_version": 3,
  "name": "Turn the page for Kindle",
  "version": "0.1.0",
  "description": "Turn Kindle Cloud Reader pages by swiping your hand in front of the webcam. Everything stays on your computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Turn the page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://read.amazon.com/*",
    "https://read.amazon.co.uk/*",
    "https://read.amazon.de/*",
    "https://read.amazon.fr/*",
    "https://read.amazon.it/*",
    "https://read.amazon.es/*",
    "https://read.amazon.nl/*",
    "https://read.amazon.co.jp/*",
    "https://read.amazon.in/*",
    "https://read.amazon.ca/*",
    "https://read.amazon.com.au/*",
    "https://read.amazon.com.br/*",
    "https://read.amazon.com.mx/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://read.amazon.com/*",
        "https://read.amazon.co.uk/*",
        "https://read.amazon.de/*",
        "https://read.amazon.fr/*",
        "https://read.amazon.it/*",
        "https://read.amazon.es/*",
        "https://read.amazon.nl/*",
        "https://read.amazon.co.jp/*",
        "https://read.amazon.in/*",
        "https://read.amazon.ca/*",
        "https://read.amazon.com.au/*",
        "https://read.amazon.com.br/*",
        "https://read.amazon.com.mx/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-gestures": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Start or stop gestures"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116"
}
